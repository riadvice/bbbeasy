{
  "name": "riadvice/bbbeasy-backend",
  "description": "BBBEasy - Web-Application Backend",
  "type": "project",
  "autoload": {
    "psr-4": {
      "": "app/src"
    }
  },
  "autoload-dev": {
    "psr-4": {
      "": [
        "app/src",
        "tests/src/"
      ]
    }
  },
  "require": {
    "php": "^8.4",
    "ext-json": "*",
    "ext-curl": "*",
    "ext-simplexml": "*",
    "ext-dom": "*",
    "ext-mbstring": "*",
    "ext-bcmath": "*",
    "ext-fileinfo": "*",
    "sukarix/sukarix": "^0.4.0",
    "nette/utils": "^v4.1.5",
    "bigbluebutton/bigbluebutton-api-php": "^3.0",
    "robmorgan/phinx": "^0.16.11",
    "symfony/yaml": "^8.1",
    "linfo/linfo": "^v4.0.9",
    "roave/better-reflection": "^6.72",
    "haydenpierce/class-finder": "^0.6.0",
    "marc-mabe/php-enum": "^v4.7.0"
  },
  "require-dev": {
    "roave/security-advisories": "dev-latest",
    "ext-xdebug": ">=3.2.0",
    "kint-php/kint": "^6.0.1",
    "fakerphp/faker": "^v1.24",
    "friendsofphp/php-cs-fixer": "^v3.95.25",
    "phpunit/php-code-coverage": "^14.0",
    "kevinlebrun/colors.php": "^1.0.3",
    "gabrielelana/byte-units": "^0.5.0",
    "phpmetrics/phpmetrics": "^v2.8.2",
    "devster/ubench": "^2.1.0",
    "rector/rector": "^2.4"
  },
  "config": {
    "optimize-autoloader": true,
    "sort-packages": false,
    "process-timeout": 600,
    "preferred-install": "dist",
    "github-protocols": [
      "https"
    ]
  },
  "scripts": {
    "csfix": [
      " sudo phpdismod -s cli xdebug",
      "vendor/bin/php-cs-fixer fix",
      "sudo phpenmod -s cli xdebug\n\n"
    ]
  },
  "license": "AGPL-3.0-or-later",
  "authors": [
    {
      "name": "RIADVICE",
      "email": "devops@riadvice.tn"
    }
  ]
}
