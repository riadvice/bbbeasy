    "dependencies": {
        "@ant-design/compatible": "^5.1.5",
        "@ant-design/cssinjs": "^2.1.2",
        "@ant-design/icons": "^5.6.1",
        "@ant-design/pro-layout": "^7.22.7",
        "@ant-design/pro-utils": "^2.18.0",
        "@types/lodash": "^4.17.16",
        "antd": "^5.24.3",
        "antd-password-input-strength": "^2.0.1",
        "axios": "^1.8.3",
        "dayjs": "^1.11.13",
        "history": "^5.3.0",
        "i18next": "^24.2.3",
        "istanbul-lib-coverage": "^3.2.0",
        "lodash": "^4.17.21",
        "moment": "^2.30.1",
        "perfect-scrollbar": "^1.5.6",
        "pino": "^9.6.0",
        "pino-pretty": "^13.0.0",
        "pm2": "^7.0.1",
        "rc-select": "^14.16.8",
        "rc-util": "^5.44.4",
        "react": "^18.3.1",
        "react-color": "^2.19.3",
        "react-copy-to-clipboard": "^5.1.1",
        "react-dom": "^18.3.1",
        "react-highlight-words": "^0.21.0",
        "react-hook-form": "^7.55.0",
        "react-i18next": "^15.4.1",
        "react-images-uploading": "^3.1.7",
        "react-intl": "^7.1.6",
        "react-router-dom": "^7.4.0",
        "react-share": "^5.2.2",
        "web-vitals": "^5.3.0",
        "websocket": "^1.0.35"
    },
    "devDependencies": {
        "@crowdin/cli": "^4.8.0",
        "@cypress/code-coverage": "^3.13.12",
        "@eslint/js": "^9.23.0",
        "@testing-library/dom": "^10.4.0",
        "@testing-library/jest-dom": "^6.6.3",
        "@testing-library/react": "^16.2.0",
        "@testing-library/user-event": "^14.6.1",
        "@types/node": "^22.13.11",
        "@types/pino": "^7.0.5",
        "@types/react": "^18.3.19",
        "@types/react-color": "^3.0.13",
        "@types/react-copy-to-clipboard": "^5.0.7",
        "@types/react-dom": "^18.3.5",
        "@types/react-highlight-words": "^0.20.1",
        "@types/react-router-dom": "^5.3.3",
        "@vitejs/plugin-react-swc": "^3.8.1",
        "babel-plugin-istanbul": "^7.0.0",
        "cypress": "^10.11.0",
        "eslint": "^9.23.0",
        "eslint-config-prettier": "^10.1.1",
        "eslint-plugin-prettier": "^5.2.3",
        "eslint-plugin-react": "^7.37.4",
        "eslint-plugin-react-hooks": "^5.2.0",
        "globals": "^16.0.0",
        "husky": "^9.1.7",
        "lint-staged": "^15.5.0",
        "nyc": "^15.1.0",
        "prettier": "^3.5.3",
        "source-map-explorer": "^2.5.3",
        "typescript": "^5.8.2",
        "typescript-eslint": "^8.27.0",
        "vite": "^6.2.2",
        "vite-plugin-istanbul": "^7.0.0",
        "vite-tsconfig-paths": "^5.1.4"
    },
    "scripts": {
        "start-dev": "../tools/bbbeasy --env development -ew && NODE_ENV=development VITE_INSTALLER_FEATURE=false vite --host --open http://bbbeasy.test/",
        "start-dev-installer": "../tools/bbbeasy --env development -ei && NODE_ENV=development VITE_INSTALLER_FEATURE=true vite --host --open http://bbbeasy.test/",
        "build": "VITE_INSTALLER_FEATURE=false GENERATE_SOURCEMAP=false vite build",
        "build-installer": "VITE_INSTALLER_FEATURE=true vite build",
        "nyc": "nyc instrument --compact=false src instrumented",
        "nyc-summary": "nyc report --reporter=text-summary",
        "cypress": "cypress run && nyc report --reporter=html && npm run nyc-summary",
        "analyze": "source-map-explorer 'dist/static/js/*.js'",
        "test": "vitest",
        "lint": "eslint src --ext .ts,.tsx",
        "format": "prettier --write 'src/**/*.{ts,tsx,scss,css,json}'",
        "isready": "npm run format && npm run lint && npm run build"
    },
    "browserslist": {
        "production": [
            ">0.2%",
            "not dead",
            "not ie <= 11"
        ],
        "development": [
            "defaults",
            "not IE 11"
        ]
    },
    "packageManager": "yarn@4.16.0"
}
