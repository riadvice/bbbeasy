{
    "name": "bbbeasy-frontend",
    "version": "0.1.0",
    "private": true,
    "type": "module",
    "dependencies": {
        "@ant-design/cssinjs": "^2.1.2",
        "@ant-design/icons": "^6",
        "@types/lodash": "^4.17.16",
        "antd": "^6",
        "antd-password-input-strength": "^2.0.1",
        "axios": "^1.8.3",
        "dayjs": "^1.11.13",
        "history": "^5.3.0",
        "i18next": "^25",
        "lodash": "^4.17.21",
        "moment": "^2.30.1",
        "perfect-scrollbar": "^1.5.6",
        "pino": "^10",
        "pino-pretty": "^13.1.3",
        "pm2": "^7.0.1",
        "rc-select": "^14.16.8",
        "rc-util": "^5.44.4",
        "react": "^19",
        "react-color": "^2.19.3",
        "react-copy-to-clipboard": "^5.1.1",
        "react-dom": "^19",
        "react-highlight-words": "^0.21.0",
        "react-hook-form": "^7.55.0",
        "react-i18next": "^15",
        "react-images-uploading": "^3.1.7",
        "react-intl": "^7.1.6",
        "react-router-dom": "^7.4.0",
        "react-share": "^5.2.2",
        "web-vitals": "^5.3.0",
        "websocket": "^1.0.35"
    },
    "devDependencies": {
        "@crowdin/cli": "^4.8.0",
        "@eslint/js": "^9",
        "@playwright/test": "^1.63.0",
        "@rc-component/form": "^1.8.6",
        "@testing-library/dom": "^10.4.0",
        "@testing-library/jest-dom": "^6.6.3",
        "@testing-library/react": "^16.2.0",
        "@testing-library/user-event": "^14.6.1",
        "@types/node": "^26.5.0",
        "@types/pg": "^8",
        "@types/pino": "^7.0.5",
        "@types/react": "^19",
        "@types/react-color": "^3.0.13",
        "@types/react-copy-to-clipboard": "^5.0.7",
        "@types/react-dom": "^19",
        "@types/react-highlight-words": "^0.20.1",
        "@types/react-router-dom": "^5.3.3",
        "@vitejs/plugin-react-swc": "^4.3.3",
        "dotenv": "^17.4.2",
        "eslint": "^9",
        "eslint-config-prettier": "^10.1.1",
        "eslint-plugin-prettier": "^5.2.3",
        "eslint-plugin-react": "^7.37.5",
        "eslint-plugin-react-hooks": "^7.1.1",
        "globals": "^17.12.0",
        "husky": "^9.1.7",
        "lint-staged": "^15.5.0",
        "nyc": "^15.1.0",
        "pg": "^8.23.0",
        "prettier": "^3.9.6",
        "source-map-explorer": "^2.5.3",
        "typescript": "^5",
        "typescript-eslint": "^8.70.0",
        "vite": "^7",
        "vite-plugin-istanbul": "^9.0.1",
        "vite-tsconfig-paths": "^6.1.1"
    },
    "scripts": {
        "start-dev": "../tools/bbbeasy --env development -ew && NODE_ENV=development VITE_INSTALLER_FEATURE=false vite --host --open http://bbbeasy.test/",
        "start-dev-installer": "../tools/bbbeasy --env development -ei && NODE_ENV=development VITE_INSTALLER_FEATURE=true vite --host --open http://bbbeasy.test/",
        "build": "VITE_INSTALLER_FEATURE=false GENERATE_SOURCEMAP=false vite build",
        "build-installer": "VITE_INSTALLER_FEATURE=true vite build",
        "nyc": "nyc instrument --compact=false src instrumented",
        "nyc-summary": "nyc report --reporter=text-summary",
        "test:e2e": "yarn playwright test",
        "test:e2e:ui": "yarn playwright test --ui",
        "test:e2e:installer": "yarn playwright test installer.spec.ts",
        "test:e2e:webapp": "yarn playwright test webapp.spec.ts",
        "analyze": "source-map-explorer 'dist/static/js/*.js'",
        "test": "vitest",
        "lint": "eslint src --ext .ts,.tsx",
        "format": "prettier --write 'src/**/*.{ts,tsx,scss,css,json}'",
        "isready": "npm run format && npm run lint && npm run build"
    },
    "browserslist": {
        "production": [
            ">0.2%",
            "not dead",
            "not ie <= 11"
        ],
        "development": [
            "defaults",
            "not IE 11"
        ]
    },
    "packageManager": "yarn@4.16.0"
}
