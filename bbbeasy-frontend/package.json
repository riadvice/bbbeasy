    "scripts": {
        "start-dev": "../tools/bbbeasy --env development -ew && PORT=3300 NODE_ENV=development ESLINT_NO_DEV_ERRORS=true INSTALLER_FEATURE=false FAST_REFRESH=true craco start",
        "start-dev-installer": "../tools/bbbeasy --env development -ei && PORT=3300 NODE_ENV=development ESLINT_NO_DEV_ERRORS=true INSTALLER_FEATURE=true FAST_REFRESH=true craco start",
        "build": "INSTALLER_FEATURE=false GENERATE_SOURCEMAP=false craco build",
        "build-installer": "INSTALLER_FEATURE=true craco build",
        "nyc": "nyc instrument --compact=false src instrumented",
        "nyc-summary": "nyc report --reporter=text-summary",
        "cypress": "cypress run && nyc report --reporter=html && npm run nyc-summary",
        "analyze": "craco analyze",
        "test": "craco test",
        "eject": "craco eject",
        "lint": "eslint --ext .js,.jsx,.ts,.tsx src --color",
        "format": "prettier --write 'src/**/*.{ts,tsx,scss,css,json}'",
        "isready": "npm run format && npm run lint && npm run build"
    },
    "eslintConfig": {
        "extends": [
            "react-app",
            "react-app/jest"
        ]
    },
    "browserslist": {
        "production": [
            ">0.2%",
            "not dead",
            "not ie <= 11"
        ],
        "development": [
            "defaults",
            "not IE 11"
