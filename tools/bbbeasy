# The real location of the script
SCRIPT=$(readlink -f "$0")

# Current unix username
USER=$(whoami)

# Directory where the script is located
BASEDIR=$(dirname "$SCRIPT")

# Production BBBEasy directory
APP_DIR=$BASEDIR/../

# Formatted current date
NOW=$(date +"%Y-%m-%d_%H.%M.%S")

# Current git branch name transforms '* dev-0.5' to 'dev-0.5'
GIT_BRANCH=$(git --git-dir="$BASEDIR/../.git" branch 2>/dev/null | sed -n '/\* /s///p')

# Git tag, commits ahead & commit id under format '0.4-160-g3bb256c'
GIT_VERSION=$(git --git-dir="$BASEDIR/../.git" describe --tags --always HEAD 2>/dev/null)

# Environment, set in run()
ENVIRONMENT=""

# Detected PHP-FPM version (e.g., 8.4 or 8.5)
PHP_VERSION=""

# Detected nginx site config path
NGINX_SITE_CONF=""

# Backend config directory
BACKEND_CONFIG_DIR="$BASEDIR/../bbbeasy-backend/app/config"

#
# Display usage
#
usage() {
  echo
  echo "#========================================================================================================"
  echo "#"
  echo "# bbbeasy Configuration Utility for BBBEasy - Version $GIT_VERSION on $GIT_BRANCH branch"
  echo "#"
  echo "#    bbbeasy [options]"
  echo "#"
  echo "# Configuration:"
  echo "#    --version                        Display BBBEasy version"
  echo "#    --selfinstall                    Make bbbeasy runnable from anywhere"
  echo "#    --enableinstaller                Enable BBBEasy installer app"
  echo "#    --enableweb                      Enable BBBEasy Web app"
  echo "#"
  echo "# Development:"
  echo "#    --enabletests                    Enable running unit tests"
  echo "#    --test <-c> <name>               Run unit tests with a test name. Use for -c coverage"
  echo "#    --fix                            Fix php code style"
  echo "#    --migrate                        Run database migrations"
  echo "#    --metrics                        Generates code metrics"
  echo "#"
  echo "# Monitoring:"
  echo "#    --check                          Check configuration files and processes for problems"
  echo "#"
  echo "# Administration:"
  echo "#    --restart                        Restart BBBEasy"
  echo "#    --stop                           Stop BBBEasy"
  echo "#    --start                          Start BBBEasy"
  echo "#    --clean                          Restart and clean all log files"
  echo "#    --cleansessions                  Cleans legacy session data (no-op with JWT)"
  echo "#    --status                         Display running status of components"
  echo "#    --zip                            Zip up log files for reporting an error"
  echo "#    --deploy                         Install dependencies, build and run migrations"
  echo "#"
  echo "# Environment:"
  echo "#    --env <development|production>   Force environment (default: auto-detect from hostname)"
  echo "#========================================================================================================"
  echo
}

#
# Load nvm if available (so yarn/npm are accessible in non-interactive shells)
#
load_nvm() {
  if [ -s "$HOME/.nvm/nvm.sh" ]; then
    # shellcheck source=/dev/null
    . "$HOME/.nvm/nvm.sh"
  fi
  if [ -s "$HOME/.nvm/bash_completion" ]; then
    # shellcheck source=/dev/null
    . "$HOME/.nvm/bash_completion"
  fi
}

#
# Detect the installed PHP-FPM version from the socket or available binaries
#
detect_php_version() {
  local version=""
  # Prefer the version that owns the active FPM socket
  if [ -S /run/php/php-fpm.sock ]; then
    version=$(readlink -f /run/php/php-fpm.sock 2>/dev/null | grep -oE 'php[0-9]+\.[0-9]+' | head -1 | sed 's/php//')
  fi
  if [ -z "$version" ]; then
    version=$(ls /run/php/ 2>/dev/null | grep -oE 'php[0-9]+\.[0-9]+' | sed 's/php//' | sort -V | tail -1)
  fi
  if [ -z "$version" ]; then
    version=$(ls /etc/php/ 2>/dev/null | grep -oE '^[0-9]+\.[0-9]+$' | sort -V | tail -1)
  fi
  if [ -z "$version" ]; then
    version=$(command -v php-fpm 2>/dev/null | grep -oE '[0-9]+\.[0-9]+$')
  fi
  if [ -z "$version" ]; then
    echo "✘ No PHP-FPM version detected. Please install PHP-FPM first."
    exit 1
  fi
  PHP_VERSION=$version
}

#
# Discover the active nginx site config for BBBEasy
#
detect_nginx_site() {
  local candidates=(
    "/etc/nginx/sites-available/bbbeasy"
    "/etc/nginx/sites-available/bbbeasy.conf"
    "/etc/nginx/sites-enabled/bbbeasy"
    "/etc/nginx/sites-enabled/bbbeasy.conf"
    "/etc/nginx/conf.d/bbbeasy.conf"
  )
  for candidate in "${candidates[@]}"; do
    if [ -f "$candidate" ]; then
      NGINX_SITE_CONF=$candidate
      return
    fi
  done
  NGINX_SITE_CONF=""
}

#
# Check file
#
check_file() {
  if [ ! -f "$1" ]; then
    echo "✘ File does not exist: $1"
    # m option means that the file is mandatory and the script cannot continue running
    if [ "$2" == "m" ]; then
      echo "✘ File $1 is mandatory. Script execution is interrupted"
      exit 1
    fi
  fi
}

need_production() {
  if [ "$ENVIRONMENT" != "production" ]; then
    echo "✘ Command can only be run in production environment"
    exit 1
  fi
}

#
# Display installed BBBEasy & servers version
#
validate_command() {
  if ! command -v "$1" &>/dev/null; then
    echo "✘ Error: Command $1 is not available. Please install it first."
    exit 1
  fi
}

display_version() {
  echo "■ BBBEasy     :  $GIT_VERSION"
  validate_command nginx
  echo "■ Nginx      :  $(nginx -v 2>&1)"
  validate_command php
  echo "■ PHP        :  $(php -v | sed -n 1p)"
  validate_command redis-server
  echo "■ Redis      :  $(redis-server --version)"
  validate_command psql
  echo "■ PostgreSQL :  $(psql -V)"
}

#
# Install bbbeasy to make runnable from anywhere
#
self_install() {
  if [ -f /usr/local/bin/bbbeasy ]; then
    echo "✘ bbbeasy already installed"
  else
    sudo ln -s "$SCRIPT" /usr/local/bin/bbbeasy
    echo "✔ bbbeasy successfully installed"
  fi
}

#
# Clean server status
#
validate_service() {
  systemctl is-active --quiet "$1" && echo "✔ $1 service is active" || echo "✘ $1 service is inactive"
}

display_status() {
  local units=("nginx" "php${PHP_VERSION}-fpm" "postgresql" "redis")
  echo
  local line='————————————————————►'
  for unit in "${units[@]}"; do
    if systemctl is-active --quiet "$unit"; then
      printf "%s %s [✔ - UP]\n" "$unit" "${line:${#unit}}"
    else
      printf "%s %s [✘ - DOWN]\n" "$unit" "${line:${#unit}}"
    fi
  done
  echo
}

#
# Clean BBBEasy cache
#
clean_cache() {
  echo "► Deleting cache"
  find "$BASEDIR/../bbbeasy-backend/bin/" ! -name '.gitkeep' -type f -exec rm -rfv {} \;
  find "$BASEDIR/../bbbeasy-backend/tmp/" ! -name '.gitkeep' -type f -exec rm -rfv {} \;
  find "$BASEDIR/../bbbeasy-backend/tmp/cache/" ! -name '.gitkeep' -type f -exec rm -rfv {} \;
  find "$BASEDIR/../bbbeasy-backend/tmp/mail/" -name '*.eml' -type f -exec rm -v {} \;
  find "$BASEDIR/../bbbeasy-backend/uploads/tmp/" -type f -exec rm -v {} \;
  find "$BASEDIR/../bbbeasy-backend/public/minified/" ! -name '.gitkeep' -type f -exec rm -v {} \;
  echo "✔ Cache deleted"
}

#
# Clean BBBEasy logs
#
clean_logs() {
  echo "► Cleaning logs"
  find "$BASEDIR/../bbbeasy-backend/logs/" ! -name '.gitkeep' -type f -exec rm -v {} \;
  echo "✔ Cleaned logs folder"
}

#
# Clean sessions from the database
#
clean_sessions() {
  echo "► Cleaning legacy sessions"
  if sudo -u postgres psql -d bbbeasy -tAc "SELECT 1 FROM information_schema.tables WHERE table_name='users_sessions'" 2>/dev/null | grep -q 1; then
    sudo -u postgres psql -d bbbeasy -c "SELECT setval('users_sessions_id_seq'::regclass, 1);" 2>/dev/null || true
    sudo -u postgres psql -d bbbeasy -c "TRUNCATE users_sessions;" 2>/dev/null || true
    echo "✔ Legacy sessions cleaned"
  else
    echo "ℹ users_sessions table does not exist (JWT auth). Nothing to clean."
  fi
}

#
# Archive logs for debugging
#
zip_logs() {
  echo "► Archiving logs"
  local ARCHIVE="/home/$USER/logs/logs-$NOW.tar.gz"
  mkdir -p "/home/$USER/logs/"
  touch /tmp/empty
  tar cfv "$ARCHIVE" /tmp/empty
  tar rfv "$ARCHIVE" "$BASEDIR/../logs/" --exclude='.gitkeep'
  sudo tar rfv "$ARCHIVE" /var/log/nginx/
  echo "✔ Logs archived at $ARCHIVE"
}

#
# Run PHP Code Style Fixer
#
fix_styles() {
  echo "► Running PHP Code Style Fixer"
  cd "$BASEDIR/../bbbeasy-backend/"
  PHP_CS_FIXER_IGNORE_ENV=true composer csfix
  echo "✔ PHP Code Style Fixed"
}

#
# Validate file exists
#
validate_file() {
  if [ ! -f "$1" ]; then
    echo "✘ Error: $1 does not exist."
    exit 1
  fi
}

#
# Ensure backend config files exist
#
ensure_backend_config() {
  if [ ! -f "$BACKEND_CONFIG_DIR/config-$ENVIRONMENT.ini" ]; then
    local SAMPLE="$BACKEND_CONFIG_DIR/config-$ENVIRONMENT.sample.ini"
    if [ -f "$SAMPLE" ]; then
      echo "► Creating $BACKEND_CONFIG_DIR/config-$ENVIRONMENT.ini from sample"
      cp "$SAMPLE" "$BACKEND_CONFIG_DIR/config-$ENVIRONMENT.ini"
    else
      echo "✘ Error: $SAMPLE does not exist. Cannot create config-$ENVIRONMENT.ini."
      exit 1
    fi
  fi
}

#
# Reload nginx after validating the configuration
#
reload_nginx() {
  detect_nginx_site
  if [ -z "$NGINX_SITE_CONF" ]; then
    echo "✘ No BBBEasy nginx site config found"
    return 1
  fi
  echo "► Validating nginx configuration"
  if sudo nginx -t; then
    echo "► Reloading nginx"
    sudo systemctl reload nginx || sudo systemctl restart nginx
  else
    echo "✘ Nginx configuration is invalid. Aborting reload."
    return 1
  fi
}

#
# Enable backend installer app
#
enable_installer() {
  ensure_backend_config
  echo "► Enabling backend installer app"
  local CONFIG="$BACKEND_CONFIG_DIR/config-$ENVIRONMENT.ini"
  validate_file "$CONFIG"
  if [ "$ENVIRONMENT" == "production" ]; then
    if grep -q -v "config.extension" "$CONFIG"; then
      echo "config.extension = -install" >>"$CONFIG"
      detect_nginx_site
      if [ -n "$NGINX_SITE_CONF" ]; then
        sudo sed -i 's/webapp/installer/g' "$NGINX_SITE_CONF"
        reload_nginx
      fi
      printf "%s %s [✔ - DONE]\n"
    fi
  else
    if [ "$(grep -c "config.extension =" "$CONFIG")" -ne 0 ]; then
      # c cmd to replace the matched line in one go
      sed -i '/config.extension =/ c config.extension = -install' "$CONFIG"
      printf "%s %s [✔ - DONE]\n"
    fi
  fi
  echo "✔ Installer app enabled"
}

#
# Enable backend web app
#
enable_web() {
  ensure_backend_config
  echo "► Enabling backend webapp"
  local CONFIG="$BACKEND_CONFIG_DIR/config-$ENVIRONMENT.ini"
  if [ "$ENVIRONMENT" == "production" ]; then
    sed -i '/^config\.extension/d' "$CONFIG"
    detect_nginx_site
    if [ -n "$NGINX_SITE_CONF" ]; then
      sudo sed -i 's/installer/webapp/g' "$NGINX_SITE_CONF"
      reload_nginx
    fi
    printf "%s %s [✔ - DONE]\n"
  else
    echo "► Enabling backend web app"
    if [ "$(grep -c "config.extension = -install" "$CONFIG")" -ne 0 ]; then
      sed -i '/config.extension = -install/ c config.extension =' "$CONFIG"
      printf "%s %s [✔ - DONE]\n"
    fi
  fi
  echo "✔ Web app enabled"
}

#
# Enable unit tests
#
enable_tests() {
  echo "► Enabling unit tests"
  rm -rfv "$BASEDIR/../bbbeasy-backend/public/statera/"
  mkdir -pv "$BASEDIR/../bbbeasy-backend/public/statera/coverage/"
  mkdir -pv "$BASEDIR/../bbbeasy-backend/public/statera/result/"
  cp -Rv "$BASEDIR/../bbbeasy-backend/tools/statera.php" "$BASEDIR/../bbbeasy-backend/public/statera/index.php"
  cp -Rv "$BASEDIR/../bbbeasy-backend/tests/ui/css" "$BASEDIR/../bbbeasy-backend/public/statera/"
  cp -Rv "$BASEDIR/../bbbeasy-backend/tests/ui/images" "$BASEDIR/../bbbeasy-backend/public/statera/"
  cp -Rv "$BASEDIR/../bbbeasy-backend/tests/ui/css" "$BASEDIR/../bbbeasy-backend/public/statera/result"
  cp -Rv "$BASEDIR/../bbbeasy-backend/tests/ui/images" "$BASEDIR/../bbbeasy-backend/public/statera/result"
  cp "$BASEDIR/../bbbeasy-backend/vendor/bcosca/fatfree-core/code.css" "$BASEDIR/../bbbeasy-backend/public/statera/css/code.css"
  cp "$BASEDIR/../bbbeasy-backend/vendor/bcosca/fatfree-core/code.css" "$BASEDIR/../bbbeasy-backend/public/statera/result/css/code.css"
  echo "✔ Unit tests enabled"
}

#
# Run unit test in CLI mode
#
run_tests() {
  echo "► Running unit tests"
  sudo phpenmod -s cli xdebug
  local COVERAGE=$1
  local USE_COVERAGE=""
  local TEST_NAME="all"
  if [[ "$1" != "-c" ]]; then
    if [[ "$1" != "" ]]; then
      TEST_NAME=$1
    fi
    if [[ "$2" == "-c" ]]; then
      USE_COVERAGE="=withCoverage"
    fi
  fi
  if [[ "$1" == "-c" ]]; then
    USE_COVERAGE="=withCoverage"
    if [[ "$2" != "" ]]; then
      TEST_NAME=$2
    fi
  fi
  cd "$(dirname "$BASEDIR")/bbbeasy-backend/"
  # Revert database base to the initial state then create it again
  "vendor/bin/phinx" rollback -e testing -t 0 -vvv
  "vendor/bin/phinx" migrate -e testing -vvv
  cd "public"
  php index.php "/api?statera$USE_COVERAGE&test=$TEST_NAME" -o="../public/statera/result/index.html"
  local SUCCESS=$(cat "statera/test.result" 2>/dev/null)
  if [[ "$SUCCESS" == "success" ]]; then
    echo "✔ Test success"
    exit 0
  else
    echo "✘ Test fail"
    exit 1
  fi
}

deploy_apps() {
  install_dependencies
  chown_folders
  chmod_folders
  run_migrations
  if [ "$ENVIRONMENT" == "production" ]; then
    start_pm2
  fi
}

#
# Updates composer and reset user home composer ownership
#
update_composer() {
  echo "► Updating composer"
  sudo composer selfupdate
  sudo chown -R "$USER:$USER" "/home/$USER/.composer/"
}

# Install composer dependencies
#
install_dependencies() {
  # Backend
  cd "$(dirname "$BASEDIR")/bbbeasy-backend/"
  echo "► Updating composer dependencies"
  if [ "$ENVIRONMENT" == "production" ]; then
    COMPOSER_ALLOW_SUPERUSER=1 composer install -o --no-dev
  else
    COMPOSER_ALLOW_SUPERUSER=1 composer install -o
  fi

  load_nvm
  ensure_yarn

  if [ "$ENVIRONMENT" == "production" ]; then
    # Installer
    cd "$(dirname "$BASEDIR")/bbbeasy-frontend/"
    rm -rf dist/
    yarn cache clean
    NODE_ENV=production yarn install
    yarn build-installer
    cp -a "$(dirname "$BASEDIR")/bbbeasy-frontend/dist/." "$(dirname "$BASEDIR")/bbbeasy-frontend/build/installer/"
    # Webapp
    cd "$(dirname "$BASEDIR")/bbbeasy-frontend/"
    rm -rf dist/
    yarn cache clean
    NODE_ENV=production yarn install
    yarn build
    cp -a "$(dirname "$BASEDIR")/bbbeasy-frontend/dist/." "$(dirname "$BASEDIR")/bbbeasy-frontend/build/webapp/"
    # Docs
    cd "$(dirname "$BASEDIR")/bbbeasy-docs/"
    yarn clear
    NODE_ENV=production yarn install
    yarn docusaurus clear
    yarn build
  else
    echo "► Development environment: skipping production frontend/docs builds"
  fi
}

#
# Ensure yarn is available (bootstrap yarn 4 if needed)
#
ensure_yarn() {
  load_nvm
  if ! command -v yarn &>/dev/null; then
    echo "✘ Error: yarn is not available. Please install Node.js and enable corepack, or install yarn."
    exit 1
  fi
  # If the project expects a local yarn release but it is missing, download it
  if [ -f "$(dirname "$BASEDIR")/bbbeasy-frontend/.yarnrc.yml" ]; then
    local YARN_PATH
    YARN_PATH=$(grep -oE 'yarnPath:.*' "$(dirname "$BASEDIR")/bbbeasy-frontend/.yarnrc.yml" | awk '{print $2}')
    if [ -n "$YARN_PATH" ] && [ ! -f "$(dirname "$BASEDIR")/bbbeasy-frontend/$YARN_PATH" ]; then
      echo "► Bootstrapping yarn release"
      (cd "$(dirname "$BASEDIR")/bbbeasy-frontend" && YARN_IGNORE_PATH=1 yarn set version 4.16.0)
    fi
  fi
}

#
# Run database migrations
#
run_migrations() {
  echo "► Running database migration"
  cd "$(dirname "$BASEDIR")/bbbeasy-backend/"
  vendor/bin/phinx migrate -e "$ENVIRONMENT"
}

#
# Generate code quality metrics
#
validate_tool() {
  if ! command -v "$1" &>/dev/null; then
    echo "✘ Error: $1 is not installed. Please install it to continue."
    exit 1
  fi
}

generate_metrics() {
  validate_tool phpmetrics
  vendor/bin/phpmetrics --report-html="$BASEDIR/../bbbeasy-backend/public/metrics" "$BASEDIR/../bbbeasy-backend/app/src/"
}

chown_folders() {
  sudo chown -R www-data: "$(dirname "$BASEDIR")/bbbeasy-frontend/build/installer/"
  sudo chown -R www-data: "$(dirname "$BASEDIR")/bbbeasy-frontend/build/webapp/"
  sudo chown -R www-data: "$(dirname "$BASEDIR")/bbbeasy-docs/build/"
  sudo chown -R www-data: "$(dirname "$BASEDIR")/bbbeasy-backend"
}

#
# Give folders right permissions
#
chmod_folders() {
  cd "$APP_DIR"
  sudo chmod -R 755 -R "$BASEDIR/../bbbeasy-backend/data/"
  sudo chmod -R 766 -R "$BASEDIR/../bbbeasy-backend/logs/"
  sudo chmod -R 766 -R "$BASEDIR/../bbbeasy-backend/tmp/"
  sudo chmod -R 755 -R "$BASEDIR/../bbbeasy-backend/uploads/"
  sudo chmod -R 755 -R "$BASEDIR/../bbbeasy-backend/public/minified/"
}

#
# Start pm2 services in production
#
start_pm2() {
  load_nvm
  ensure_yarn
  if [ -f "$(dirname "$BASEDIR")/ecosystem/ecosystem.config.js" ]; then
    echo "► Starting pm2 services"
    cd "$(dirname "$BASEDIR")/ecosystem"
    pm2 start ecosystem.config.js
    pm2 save
    echo "✔ PM2 services started"
  fi
}

#
# Stop pm2 services
#
stop_pm2() {
  load_nvm
  if [ -f "$(dirname "$BASEDIR")/ecosystem/ecosystem.config.js" ]; then
    echo "► Stopping pm2 services"
    cd "$(dirname "$BASEDIR")/ecosystem"
    pm2 stop ecosystem.config.js || true
    echo "✔ PM2 services stopped"
  fi
}

#
# Start services
#
start_services() {
  sudo service postgresql start
  sudo service redis start
  sudo service nginx start
  sudo service "php${PHP_VERSION}-fpm" start
  if [ "$ENVIRONMENT" == "production" ]; then
    start_pm2
  fi
}

#
# Stop services
#
stop_services() {
  if [ "$ENVIRONMENT" == "production" ]; then
    stop_pm2
  fi
  sudo service "php${PHP_VERSION}-fpm" stop
  sudo service nginx stop
  sudo service redis stop
  sudo service postgresql stop
}

#
# Restart services
#
restart_services() {
  sudo service postgresql restart
  sudo service redis restart
  sudo service nginx restart
  sudo service "php${PHP_VERSION}-fpm" restart
  if [ "$ENVIRONMENT" == "production" ]; then
    stop_pm2
    start_pm2
  fi
}

#
# Check configuration and processes for problems
#
check_config() {
  detect_nginx_site
  echo "► Environment   : $ENVIRONMENT"
  echo "► PHP version   : $PHP_VERSION"
  echo "► Nginx site    : ${NGINX_SITE_CONF:-not found}"
  echo "► Checking nginx configuration"
  sudo nginx -t
  echo "► Checking service status"
  display_status
}

run() {
  if [[ $# -eq 0 ]]; then
    usage
    exit 1
  fi

  # Environment detection
  HOST_TESTER=$(hostname)
  if [[ "$HOST_TESTER" == "bbbeasy.test" ]]; then
    ENVIRONMENT="development"
  else
    ENVIRONMENT="production"
  fi

  # Parse arguments
  local args=("$@")
  local i=0
  while [[ $i -lt ${#args[@]} ]]; do
    case "${args[$i]}" in
    --env)
      ENVIRONMENT="${args[$((i + 1))]}"
      i=$((i + 2))
      ;;
    --env=*)
      ENVIRONMENT="${args[$i]#*=}"
      i=$((i + 1))
      ;;
    *)
      i=$((i + 1))
      ;;
    esac
  done

  detect_php_version
  load_nvm

  echo "► Detected environment: \`$ENVIRONMENT\`"
  echo "► Detected PHP-FPM    : php${PHP_VERSION}-fpm"

  while [[ $# -gt 0 ]]; do
    if [ "$1" = "--version" -o "$1" = "-version" -o "$1" = "-v" ]; then
      display_version
      shift
      continue
    fi
    if [ "$1" = "--selfinstall" -o "$1" = "-selfinstall" -o "$1" = "-si" ]; then
      self_install
      shift
      continue
    fi
    if [ "$1" = "--enableinstaller" -o "$1" = "-enableinstaller" -o "$1" = "-ei" ]; then
      enable_installer
      shift
      continue
    fi
    if [ "$1" = "--enableweb" -o "$1" = "-enableweb" -o "$1" = "-ew" ]; then
      enable_web
      shift
      continue
    fi
    if [ "$1" = "--enabletests" -o "$1" = "-enabletests" -o "$1" = "-e" ]; then
      enable_tests
      shift
      continue
    fi
    if [ "$1" = "--test" -o "$1" = "-test" -o "$1" = "-t" ]; then
      fix_styles
      run_tests "$2" "$3"
      shift
      shift
      shift
      continue
    fi
    if [ "$1" = "--check" -o "$1" = "-check" ]; then
      check_config
      shift
      continue
    fi
    if [ "$1" = "--fix" -o "$1" = "-fix" -o "$1" = "-f" ]; then
      fix_styles
      shift
      continue
    fi
    if [ "$1" = "--migrate" -o "$1" = "-migrate" -o "$1" = "-m" ]; then
      run_migrations
      shift
      continue
    fi
    if [ "$1" = "--metrics" -o "$1" = "-metrics" -o "$1" = "-me" ]; then
      generate_metrics
      shift
      continue
    fi
    if [ "$1" = "--clean" -o "$1" = "-clean" ]; then
      clean_cache
      clean_logs
      shift
      continue
    fi
